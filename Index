<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Formulario de Alumnos</title>
</head>

<body>

    <header>
        <h1>Formulario de Registro de Alumnos</h1>
        <p>
            Complete el siguiente formulario para registrar un alumno en la base de datos.
        </p>
    </header>

    <main>

        <form action="procesar_alumno.php" method="POST">

            <!-- Información Personal -->
            <fieldset>

                <legend>Información Personal</legend>

                <div>
                    <label for="nombre">Nombre:</label>
                    <input
                        type="text"
                        id="nombre"
                        name="nombre"
                        placeholder="Primer y segundo nombre"
                        required>
                </div>

                <br>

                <div>
                    <label for="apellido">Apellido:</label>
                    <input
                        type="text"
                        id="apellido"
                        name="apellido"
                        placeholder="Primer y segundo apellido"
                        required>
                </div>

                <br>

                <div>
                    <label for="dni">DNI:</label>
                    <input
                        type="text"
                        id="dni"
                        name="dni"
                        placeholder="12345678"
                        maxlength="8"
                        pattern="[0-9]{8}"
                        required>
                </div>

                <br>

                <div>
                    <label for="edad">Edad:</label>
                    <input
                        type="number"
                        id="edad"
                        name="edad"
                        min="3"
                        max="30"
                        required>
                </div>

                <br>

                <div>

                    <label>Género:</label>

                    <input
                        type="radio"
                        id="masculino"
                        name="genero"
                        value="Masculino"
                        required>

                    <label for="masculino">Masculino</label>

                    <input
                        type="radio"
                        id="femenino"
                        name="genero"
                        value="Femenino">

                    <label for="femenino">Femenino</label>

                </div>

            </fieldset>

            <br>

            <!-- Información de Contacto -->
            <fieldset>

                <legend>Información de Contacto</legend>

                <div>

                    <label for="telefono">Teléfono:</label>

                    <input
                        type="tel"
                        id="telefono"
                        name="telefono"
                        placeholder="1122334455"
                        pattern="[0-9]{10}"
                        required>

                </div>

                <br>

                <div>

                    <label for="colegio">Colegio:</label>

                    <select id="colegio" name="colegio" required>

                        <option value="">Seleccione un colegio</option>

                        <option value="1">Colegio Nº1</option>
                        <option value="2">Colegio Nº2</option>
                        <option value="3">Colegio Nº3</option>

                    </select>

                </div>

                <br>

                <div>

                    <label for="correo">Correo Institucional:</label>

                    <input
                        type="email"
                        id="correo"
                        name="correo"
                        placeholder="alumno@colegio.edu.ar"
                        required>

                </div>

            </fieldset>

            <br>

            <!-- Especialización -->
            <fieldset>

                <legend>Especialización</legend>

                <div>

                    <label for="especializacion">Especialidad:</label>

                    <select id="especializacion" name="especializacion" required>

                        <option value="">Seleccione una especialidad</option>

                        <option>Programación</option>
                        <option>Electrónica</option>
                        <option>Mecánica</option>
                        <option>Informática</option>

                    </select>

                </div>

                <br>

                <div>

                    <label for="preferencia">Área de Preferencia:</label>

                    <select id="preferencia" name="preferencia" required>

                        <option value="">Seleccione un área</option>

                        <option>Desarrollo Web</option>
                        <option>Software</option>
                        <option>Hardware</option>
                        <option>Mantenimiento</option>
                        <option>Redes</option>
                        <option>Diseño Gráfico</option>

                    </select>

                </div>

            </fieldset>

            <br>

            <input type="submit" value="Registrar Alumno">
            <input type="reset" value="Limpiar Formulario">

        </form>

    </main>

</body>
</html>
